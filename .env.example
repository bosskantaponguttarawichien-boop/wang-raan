# วางร้าน (Wang-Raan) — ตัวอย่างค่าสภาพแวดล้อม (คัดลอกเป็น .env.local)

# Auth.js v5 (feat-031) — จำเป็นใน production: สร้างด้วย `openssl rand -base64 32`
AUTH_SECRET=
# GitHub OAuth (ไม่บังคับ) — ถ้าไม่ตั้ง ใช้ได้เฉพาะการเข้าสู่ระบบแบบผู้ใช้ทั่วไป (Guest)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Backend (สัญญา: contracts/openapi.yaml) — origin ของ Backend เช่น https://api.wangraan.com (ไม่ต้องใส่ /v1)
# - production: **จำเป็น** ทั้งสองค่า ไม่งั้น API ตอบ 503 BACKEND_NOT_CONFIGURED (ไม่มีการเก็บข้อมูลในหน่วยความจำแทน)
# - dev / test: ถ้าไม่ตั้ง ใช้ Backend จำลองในตัว (mock-backend/handler — ข้อมูลหายเมื่อรีสตาร์ต)
#   อยากเห็นคำขอผ่านเครือข่ายจริง: `npm run mock:build && INTERNAL_TOKEN_SECRET=dev npm run mock:start` แล้วตั้ง
#   WANGRAAN_BACKEND_URL=http://localhost:4010 และ INTERNAL_TOKEN_SECRET=dev
WANGRAAN_BACKEND_URL=
# secret สำหรับ internal token (Bearer) ที่ BFF ส่งต่อให้ Backend — ต้องตรงกับฝั่ง Backend
INTERNAL_TOKEN_SECRET=

# ฟอร์มติดต่อ: ส่งต่อ Backend (POST /v1/contact-messages) — การแจ้งเตือนทีมงานและ rate limit อยู่ที่ Backend

# จำนวน proxy ที่ไว้ใจหน้าเว็บ (Vercel / Nginx = 1) — ใช้เลือก IP จริงจาก X-Forwarded-For สำหรับ Rate limit
TRUSTED_PROXY_HOPS=0

# origin ของเว็บ เช่น https://wangraan.com — production **ต้องตั้ง** เพื่อสร้าง URL ของ OG image ในหน้าแชร์ (dev ไม่ตั้ง = ใช้ host ของคำขอ)
SITE_URL=
