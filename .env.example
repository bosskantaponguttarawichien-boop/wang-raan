# วางร้าน (Wang-Raan) — ตัวอย่างค่าสภาพแวดล้อม (คัดลอกเป็น .env.local)

# Auth.js v5 (feat-031) — จำเป็นใน production: สร้างด้วย `openssl rand -base64 32`
AUTH_SECRET=
# GitHub OAuth (ไม่บังคับ) — ถ้าไม่ตั้ง ใช้ได้เฉพาะการเข้าสู่ระบบแบบผู้ใช้ทั่วไป (Guest)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Backend Layout Service (ไม่บังคับ) — ถ้าไม่ตั้ง BFF เก็บผังในหน่วยความจำ (หายเมื่อรีสตาร์ต)
WANGRAAN_BACKEND_URL=
# secret สำหรับ internal token (Bearer) ที่ BFF ส่งต่อให้ Backend — ต้องตรงกับฝั่ง Backend
INTERNAL_TOKEN_SECRET=

# ฟอร์มติดต่อ (feat-032) — Webhook ปลายทาง (Slack / อีเมลเกตเวย์); ถ้าไม่ตั้ง เก็บไว้ในหน่วยความจำ
CONTACT_WEBHOOK_URL=
